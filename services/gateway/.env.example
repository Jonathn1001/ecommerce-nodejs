# At least one of JWT_PUBLIC_KEY / JWKS_URL must be set — main.ts refuses to boot otherwise.
JWT_PUBLIC_KEY=
JWKS_URL=
JWKS_TTL_MS=600000
IDENTITY_URL=http://localhost:3006
ORDER_URL=http://localhost:3002
CATALOG_URL=http://localhost:3004
PAYMENT_URL=http://localhost:3003
GRANTS_TTL_MS=60000
BREAKER_TIMEOUT_MS=5000
BREAKER_RESET_MS=10000
COOKIE_SECURE=false
PORT=8000
METRICS_PORT=9464
LOG_LEVEL=info
